# ==========================================
# Street Food Finder - AWS Environment Variables
# ==========================================

# 1. Database Configuration (AWS RDS PostgreSQL)
# Example RDS Endpoint:
# DATABASE_URL=postgresql://postgres:<password>@street-food-db.<unique-id>.<region>.rds.amazonaws.com:5432/street_food_finder?sslmode=require
DATABASE_URL="postgresql://postgres:password@localhost:5432/street_food_finder"
DATABASE_SSL="false"
DATABASE_SSL_REJECT_UNAUTHORIZED="false"

# 2. AWS Credentials & S3 Storage
# IAM User with AmazonS3FullAccess or custom S3 scoped policy
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET_NAME=""

# 3. AWS CloudFront CDN (Optional for CDN distribution)
# Example: d123456abcdef8.cloudfront.net
AWS_CLOUDFRONT_DOMAIN=""

# 4. App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"


street-food-db.c9ua20u68z4q.ap-southeast-2.rds.amazonaws.com

